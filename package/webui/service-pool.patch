+export function upstreamAddressText(server: Pick<UpStreamServers, 'pool_enabled' | 'diagnostics' | 'endpoint_ips' | 'ip'>): string {
+  if (!server.pool_enabled) return server.ip;
+  const runtime = server.diagnostics?.runtime;
+  const ips = runtime ? (Array.isArray(runtime.wans) ? runtime.wans.filter(wan => wan.connected && wan.ip).map(wan => wan.ip) : []) : (server.endpoint_ips ?? []);
+  return [...new Set(ips.filter(Boolean))].join(', ') || '—';
+}
+
+export function queryAccounting(server: Pick<UpStreamServers, 'query_count' | 'success_count' | 'failure_count' | 'skip_count' | 'in_flight'>): { total: number; accepted: number; failed: number; unsent: number; pending: number; closed: boolean } | null {
+  const values = [server.query_count, server.success_count, server.failure_count, server.skip_count, server.in_flight];
+  if (!values.every(value => typeof value === 'number' && Number.isSafeInteger(value) && value >= 0)) return null;
+  const [total, accepted, failed, unsent, pending] = values as number[];
+  return { total, accepted, failed, unsent, pending, closed: total === accepted + failed + unsent + pending };
+}
+
+export type DiagnosticEvent = UpstreamPolicyData['events'][number];
+export interface EventGroup { key: string; newest: DiagnosticEvent; events: DiagnosticEvent[]; ips: string[] }
+
+// Group a bounded burst for presentation only. Every original event remains
+// inspectable, with its own sequence, query, backend and capture timestamp.
+export function groupEvents(events: DiagnosticEvent[]): EventGroup[] {
+  const groups: EventGroup[] = [];
+  for (const event of events.toSorted((a,b) => b.sequence-a.sequence)) {
+    const key = [event.kind,event.phase,event.code,
+      ...([10,11].includes(event.kind) ? [] : [event.domain ?? '',event.qtype ?? 0])].join('|');
+    const group = groups.find(g => g.key === key && Math.abs(event.age_ms-g.newest.age_ms) <= 1500);
+    if (group) { group.events.push(event); if (!group.ips.includes(event.ip)) group.ips.push(event.ip); }
+    else groups.push({key,newest:event,events:[event],ips:[event.ip]});
+  }
+  return groups;
+}
+
+export function eventCategory(event: DiagnosticEvent): string {
+  if ([10,11].includes(event.kind)) return 'http';
+  if ([1,12].includes(event.kind)) return 'dns';
+  if ([0,7,8,9].includes(event.kind)) return 'timeout';
+  return 'connection';
+}
+
+export function eventTime(timestamp?: number | null, locale='zh-CN'): string | null {
+  if (typeof timestamp !== 'number' || !Number.isFinite(timestamp) || timestamp <= 0 || timestamp > 8640000000000000) return null;
+  return new Intl.DateTimeFormat(locale,{year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',
+    second:'2-digit',fractionalSecondDigits:3,hourCycle:'h23',timeZoneName:'shortOffset'}).format(timestamp);
+}
